{
  "name": "@repo/devkit",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "exports": {
    "./otp": {
      "types": "./src/lib/otp.ts",
      "default": "./src/lib/otp.ts"
    }
  },
  "scripts": {
    "build": "tsc --build tsconfig.build.json",
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "env:generate": "tsx src/generate-env.ts",
    "linear:apply": "tsx src/commands/linear-apply.ts",
    "linear:auth": "tsx src/commands/linear-auth.ts",
    "linear:check": "tsx src/commands/linear-check.ts",
    "linear:create": "tsx src/commands/linear-create.ts",
    "linear:document": "tsx src/commands/linear-document.ts",
    "linear:query": "tsx src/commands/linear-query.ts",
    "linear:taxonomy": "tsx src/commands/linear-taxonomy.ts",
    "linear:upload": "tsx src/commands/linear-upload.ts",
    "linear:view": "tsx src/commands/linear-view.ts",
    "lint": "eslint",
    "login": "tsx src/commands/login.ts",
    "release:cms": "tsx src/commands/release-cms.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "dotenv": "^16.6.1",
    "jsdom": "catalog:testing",
    "mermaid": "^11.16.1",
    "postgres": "^3.4.8"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@repo/vitest-config": "workspace:*",
    "@types/jsdom": "^21.1.7",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "tsx": "^4.21.0",
    "typescript": "catalog:",
    "vitest": "catalog:testing"
  }
}
