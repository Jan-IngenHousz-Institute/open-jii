{
  "run_name": "Export carry-over ({ENV})",
  "run_as": { "service_principal_name": "{NODE_SP_APP_ID}" },
  "tasks": [
    {
      "task_key": "export_carry_over",
      "environment_key": "carry_over",
      "notebook_task": {
        "notebook_path": "/Workspace/Shared/.bundle/open-jii/{ENV}/notebooks/src/tasks/export_carry_over_task",
        "source": "WORKSPACE",
        "base_parameters": {
          "EXPORT_JOB_ID": "{EXPORT_JOB_ID}",
          "CATALOG_NAME": "open_jii_{ENV}",
          "ENVIRONMENT": "{ENV}",
          "DAYS": "30"
        }
      }
    }
  ],
  "environments": [
    {
      "environment_key": "carry_over",
      "spec": {
        "environment_version": "4",
        "dependencies": [
          "/Workspace/Shared/.bundle/open-jii/{ENV}/artifacts/.internal/openjii-0.1.0-py3-none-any.whl",
          "/Workspace/Shared/.bundle/open-jii/{ENV}/artifacts/.internal/enrich-0.1.0-py3-none-any.whl"
        ]
      }
    }
  ]
}
