{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DescribeTheEstate",
      "Effect": "Allow",
      "Action": [
        "acm:Describe*",
        "acm:List*",
        "apigateway:GET",
        "application-autoscaling:Describe*",
        "autoscaling:Describe*",
        "backup:Describe*",
        "backup:List*",
        "budgets:View*",
        "ce:Get*",
        "ce:Describe*",
        "cloudfront:Get*",
        "cloudfront:List*",
        "cloudtrail:Describe*",
        "cloudtrail:Get*",
        "cloudtrail:List*",
        "cloudtrail:LookupEvents",
        "cloudwatch:Describe*",
        "cloudwatch:Get*",
        "cloudwatch:List*",
        "cognito-identity:Describe*",
        "cognito-identity:List*",
        "cognito-idp:Describe*",
        "cognito-idp:List*",
        "dynamodb:Describe*",
        "dynamodb:List*",
        "ec2:Describe*",
        "ecr:Describe*",
        "ecr:List*",
        "ecs:Describe*",
        "ecs:List*",
        "elasticloadbalancing:Describe*",
        "events:Describe*",
        "events:List*",
        "firehose:Describe*",
        "firehose:List*",
        "iam:Get*",
        "iam:List*",
        "iam:Simulate*",
        "iot:Describe*",
        "iot:Get*",
        "iot:List*",
        "kinesis:Describe*",
        "kinesis:List*",
        "kms:Describe*",
        "kms:List*",
        "lambda:GetFunctionConfiguration",
        "lambda:GetPolicy",
        "lambda:GetAlias",
        "lambda:GetEventSourceMapping",
        "lambda:List*",
        "logs:Describe*",
        "logs:FilterLogEvents",
        "logs:GetLogEvents",
        "logs:GetLogGroupFields",
        "logs:GetQueryResults",
        "logs:StartQuery",
        "logs:StopQuery",
        "rds:Describe*",
        "rds:List*",
        "route53:Get*",
        "route53:List*",
        "s3:GetBucket*",
        "s3:GetEncryptionConfiguration",
        "s3:GetLifecycleConfiguration",
        "s3:ListAllMyBuckets",
        "s3:ListBucket",
        "scheduler:Get*",
        "scheduler:List*",
        "secretsmanager:DescribeSecret",
        "secretsmanager:ListSecrets",
        "ses:Get*",
        "ses:List*",
        "sns:Get*",
        "sns:List*",
        "sqs:GetQueueAttributes",
        "sqs:List*",
        "ssm:DescribeParameters",
        "ssm:GetParameter",
        "ssm:GetParameters",
        "ssm:GetParametersByPath",
        "ssm:GetParameterHistory",
        "states:Describe*",
        "states:List*",
        "sts:GetCallerIdentity",
        "tag:GetResources",
        "wafv2:Get*",
        "wafv2:List*"
      ],
      "Resource": "*"
    },
    {
      "Sid": "ReadOperationalState",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": ["arn:aws:s3:::open-jii-heartbeat-*/*", "arn:aws:s3:::open-jii-status-state-*/*"]
    },
    {
      "Sid": "NoResearchDataOrObjects",
      "Effect": "Deny",
      "Action": [
        "s3:GetObject",
        "s3:GetObjectVersion",
        "s3:GetObjectAttributes",
        "s3:GetObjectTorrent"
      ],
      "NotResource": [
        "arn:aws:s3:::open-jii-heartbeat-*/*",
        "arn:aws:s3:::open-jii-status-state-*/*"
      ]
    },
    {
      "Sid": "NoDataSecretsOrCredentials",
      "Effect": "Deny",
      "Action": [
        "athena:GetQueryResults",
        "cognito-identity:GetCredentialsForIdentity",
        "cognito-identity:GetId",
        "cognito-identity:GetOpenIdToken*",
        "dynamodb:BatchGetItem",
        "dynamodb:GetItem",
        "dynamodb:Query",
        "dynamodb:Scan",
        "ecr:BatchGetImage",
        "ecr:GetAuthorizationToken",
        "ecr:GetDownloadUrlForLayer",
        "ecs:ExecuteCommand",
        "iot:Connect",
        "iot:GetRetainedMessage",
        "iot:GetThingShadow",
        "iot:Publish",
        "iot:Receive",
        "iot:Subscribe",
        "kinesis:GetRecords",
        "kinesis:GetShardIterator",
        "kinesis:SubscribeToShard",
        "kms:Decrypt",
        "kms:GenerateDataKey*",
        "lambda:GetFunction",
        "lambda:InvokeFunction*",
        "logs:CreateExportTask",
        "logs:StartLiveTail",
        "rds:DownloadDBLogFilePortion",
        "rds-data:*",
        "rds-db:connect",
        "secretsmanager:GetSecretValue",
        "sqs:ReceiveMessage",
        "ssm:SendCommand",
        "ssm:StartSession",
        "sso:GetRoleCredentials",
        "sts:AssumeRole*",
        "sts:GetFederationToken",
        "sts:GetSessionToken"
      ],
      "Resource": "*"
    },
    {
      "Sid": "NoIrreversibleWrites",
      "Effect": "Deny",
      "Action": [
        "backup:DeleteRecoveryPoint",
        "cloudformation:DeleteStack",
        "dynamodb:DeleteTable",
        "ec2:DeleteSnapshot",
        "ec2:DeleteVolume",
        "ec2:TerminateInstances",
        "ecr:BatchDeleteImage",
        "ecr:DeleteRepository",
        "iam:CreateAccessKey",
        "iam:DeleteRole",
        "iam:DeleteUser",
        "kms:ScheduleKeyDeletion",
        "logs:DeleteLogGroup",
        "rds:DeleteDBCluster",
        "rds:DeleteDBClusterSnapshot",
        "rds:DeleteDBInstance",
        "rds:DeleteDBSnapshot",
        "s3:DeleteBucket",
        "s3:DeleteObject*",
        "s3:PutBucketPolicy",
        "s3:PutLifecycleConfiguration",
        "secretsmanager:DeleteSecret"
      ],
      "Resource": "*"
    }
  ]
}
