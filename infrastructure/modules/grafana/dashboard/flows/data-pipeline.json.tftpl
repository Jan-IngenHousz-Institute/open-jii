                "type": "cloudwatch",
                "uid": "${datasource_uid}"
              },
              "dimensions": {
                "StreamName": "${kinesis_stream_name}"
              },
              "expression": "m0/1024/1024/PERIOD(m0)",
              "id": "e0",
