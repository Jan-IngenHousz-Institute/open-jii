              "matchExact": true,
              "metricEditorMode": 1,
              "metricQueryType": 0,
              "period": "60",
              "queryMode": "Metrics",
              "refId": "e0",
              "region": "${aws_region}",
              "sqlExpression": "",
              "statistic": "Sum"
            },
            {
              "datasource": {
                "type": "cloudwatch",
                "uid": "${datasource_uid}"
              },
              "dimensions": {
                "StreamName": "${kinesis_stream_name}"
              },
              "expression": "",
              "hide": true,
              "id": "m0",
              "label": "",
              "matchExact": true,
              "metricEditorMode": 0,
              "metricName": "GetRecords.Bytes",
              "metricQueryType": 0,
              "namespace": "AWS/Kinesis",
              "period": "60",
              "queryMode": "Metrics",
              "refId": "m0",
              "region": "${aws_region}",
              "sqlExpression": "",
              "statistic": "Sum"
            },
            {
              "datasource": {
                "type": "cloudwatch",
                "uid": "${datasource_uid}"
              },
              "dimensions": {
                "StreamName": "${kinesis_stream_name}"
              },
              "expression": "2 * IF(m0, 1, 1)",
              "id": "e1",
              "label": "Read limit",
              "matchExact": true,
              "metricEditorMode": 1,
              "metricQueryType": 0,
              "period": "60",
              "queryMode": "Metrics",
              "refId": "e1",
              "region": "${aws_region}",
              "sqlExpression": "",
              "statistic": "Sum"
            }
          ],
