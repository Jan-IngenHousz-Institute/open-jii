    {
      "key": "logs",
      "panels": [
        {
          "id": 515,
          "type": "row",
          "title": "IoT logs",
          "collapsed": true,
          "panels": [
            {
              "datasource": {
                "type": "cloudwatch",
                "uid": "${logs_datasource_uid}"
              },
              "description": "The latest IoT Core events, newest first: connections, publishes and the rules that forward them. Click a trace to see every event of that message. [View in CloudWatch Logs](https://${aws_region}.console.aws.amazon.com/cloudwatch/home?region=${aws_region}#logsV2:log-groups/log-group/${iot_log_group_name})",
              "gridPos": {
                "h": 14,
                "w": 24,
                "x": 0,
                "y": 1
              },
              "id": 516,
              "timeFrom": "24h",
              "options": {
                "sortBy": [
                  {
                    "displayName": "Time",
                    "desc": true
                  }
                ],
                "showHeader": true,
                "cellHeight": "sm",
                "footer": {
                  "show": false,
                  "reducer": [
                    "sum"
                  ],
                  "countRows": false,
                  "fields": ""
                }
              },
              "fieldConfig": {
                "defaults": {
                  "noValue": "-",
                  "custom": {
                    "align": "auto",
                    "cellOptions": {
                      "type": "auto"
                    },
                    "inspect": true
                  }
                },
                "overrides": [
                  {
                    "matcher": {
                      "id": "byName",
                      "options": "@timestamp"
                    },
                    "properties": [
                      {
                        "id": "displayName",
                        "value": "Time"
                      },
                      {
                        "id": "custom.width",
                        "value": 170
                      }
                    ]
                  },
                  {
                    "matcher": {
                      "id": "byName",
                      "options": "level"
                    },
                    "properties": [
                      {
                        "id": "displayName",
                        "value": "Level"
                      },
                      {
                        "id": "custom.width",
                        "value": 64
                      },
                      {
                        "id": "custom.cellOptions",
                        "value": {
                          "type": "color-text"
                        }
                      },
                      {
                        "id": "mappings",
                        "value": [
                          {
                            "type": "value",
                            "options": {
                              "DEBUG": {
                                "text": "debug",
                                "color": "text",
                                "index": 0
                              },
                              "INFO": {
                                "text": "info",
                                "color": "text",
                                "index": 1
                              },
                              "WARN": {
                                "text": "warn",
                                "color": "orange",
                                "index": 2
                              },
                              "ERROR": {
                                "text": "error",
                                "color": "red",
                                "index": 3
                              }
                            }
                          }
                        ]
                      }
                    ]
                  },
                  {
                    "matcher": {
                      "id": "byName",
                      "options": "event"
                    },
                    "properties": [
                      {
                        "id": "displayName",
                        "value": "Event"
                      },
                      {
                        "id": "custom.width",
                        "value": 130
                      }
                    ]
                  },
                  {
                    "matcher": {
                      "id": "byName",
                      "options": "status"
                    },
                    "properties": [
                      {
                        "id": "displayName",
                        "value": "Status"
                      },
                      {
                        "id": "custom.width",
                        "value": 80
                      },
                      {
                        "id": "custom.cellOptions",
                        "value": {
                          "type": "color-text"
                        }
                      },
                      {
                        "id": "mappings",
                        "value": [
                          {
                            "type": "value",
                            "options": {
                              "Success": {
                                "text": "Success",
                                "color": "text",
                                "index": 0
                              },
                              "Failure": {
                                "text": "Failure",
                                "color": "red",
                                "index": 1
                              }
                            }
                          }
                        ]
                      }
                    ]
                  },
                  {
                    "matcher": {
                      "id": "byName",
                      "options": "device"
                    },
                    "properties": [
                      {
                        "id": "displayName",
                        "value": "Device"
                      },
                      {
                        "id": "custom.width",
                        "value": 200
                      }
                    ]
                  },
                  {
                    "matcher": {
                      "id": "byName",
                      "options": "experiment"
                    },
                    "properties": [
                      {
                        "id": "displayName",
                        "value": "Experiment"
                      },
                      {
                        "id": "custom.width",
                        "value": 290
                      }
                    ]
                  },
                  {
                    "matcher": {
                      "id": "byName",
                      "options": "family"
                    },
                    "properties": [
                      {
                        "id": "displayName",
                        "value": "Family"
                      },
                      {
                        "id": "custom.width",
                        "value": 80
                      }
                    ]
                  },
                  {
                    "matcher": {
                      "id": "byName",
                      "options": "rule"
                    },
                    "properties": [
                      {
                        "id": "displayName",
                        "value": "Rule"
                      },
                      {
                        "id": "custom.width",
                        "value": 260
                      }
                    ]
                  },
                  {
                    "matcher": {
                      "id": "byName",
                      "options": "reason"
                    },
                    "properties": [
                      {
                        "id": "displayName",
                        "value": "Reason"
                      },
                      {
                        "id": "custom.width",
                        "value": 160
                      }
                    ]
                  },
                  {
                    "matcher": {
                      "id": "byName",
                      "options": "details"
                    },
                    "properties": [
                      {
                        "id": "displayName",
                        "value": "Details"
                      },
                      {
                        "id": "custom.minWidth",
                        "value": 200
                      }
                    ]
                  },
                  {
                    "matcher": {
                      "id": "byName",
                      "options": "trace"
                    },
                    "properties": [
                      {
                        "id": "displayName",
                        "value": "Trace"
                      },
                      {
                        "id": "custom.width",
                        "value": 110
                      },
                      {
                        "id": "links",
                        "value": [
                          {
                            "title": "Every event of this message",
                            "url": "${iot_trace_logs_url}",
                            "targetBlank": true
                          }
                        ]
                      }
                    ]
                  }
                ]
              },
              "targets": [
                {
                  "datasource": {
                    "type": "cloudwatch",
                    "uid": "${logs_datasource_uid}"
                  },
                  "expression": "fields @timestamp, logLevel as level, eventType as event, status, clientId as device, replace(ruleName, \"open_jii_${environment}_iot_rule_\", \"\") as rule, reason, details, traceId as trace\n| parse topicName \"experiment/data_ingest/v1/*/*/*/*\" as experiment, family, family_version, sensor\n| sort @timestamp desc\n| limit 500",
                  "id": "",
                  "logGroups": [
                    {
                      "accountId": "${account_id}",
                      "arn": "arn:aws:logs:${aws_region}:${account_id}:log-group:${iot_log_group_name}:*",
                      "name": "${iot_log_group_name}"
                    }
                  ],
                  "queryMode": "Logs",
                  "refId": "A",
                  "region": "${aws_region}",
                  "statsGroups": []
                }
              ],
              "transformations": [
                {
                  "id": "organize",
                  "options": {
                    "indexByName": {
                      "@timestamp": 0,
                      "Time": 0,
                      "level": 1,
                      "event": 2,
                      "status": 3,
                      "device": 4,
                      "experiment": 5,
                      "family": 6,
                      "rule": 7,
                      "reason": 8,
                      "details": 9,
                      "trace": 10
                    },
                    "excludeByName": {
                      "family_version": true,
                      "sensor": true
                    }
                  }
                }
              ],
              "title": "IoT Core connection and event logs",
              "type": "table"
            }
          ],
          "gridPos": {
            "h": 1,
            "w": 24,
            "x": 0,
            "y": 0
          }
        }
      ]
    }
  ]
}
