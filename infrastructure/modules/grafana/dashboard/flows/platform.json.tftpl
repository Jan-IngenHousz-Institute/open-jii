    {
      "key": "logs",
      "panels": [
        {
          "id": 334,
          "type": "row",
          "title": "API logs",
          "collapsed": true,
          "panels": [
            {
              "datasource": {
                "type": "cloudwatch",
                "uid": "${logs_datasource_uid}"
              },
              "description": "The latest backend log lines, newest first, without health checks. Source is the class that logged and operation its method. Click a request to see every line it logged.",
              "gridPos": {
                "h": 14,
                "w": 24,
                "x": 0,
                "y": 1
              },
              "id": 335,
              "options": {
                "sortBy": [
                  {
                    "displayName": "Time",
                    "desc": true
                  }
                ],
                "showHeader": true,
                "cellHeight": "sm",
                "footer": {
                  "show": false,
                  "reducer": [
                    "sum"
                  ],
                  "countRows": false,
                  "fields": ""
                }
              },
              "fieldConfig": {
                "defaults": {
                  "noValue": "-",
                  "custom": {
                    "align": "auto",
                    "cellOptions": {
                      "type": "auto"
                    },
                    "inspect": true
                  }
                },
                "overrides": [
                  {
                    "matcher": {
                      "id": "byName",
                      "options": "@timestamp"
                    },
                    "properties": [
                      {
                        "id": "displayName",
                        "value": "Time"
                      },
                      {
                        "id": "custom.width",
                        "value": 170
                      }
                    ]
                  },
                  {
                    "matcher": {
                      "id": "byName",
                      "options": "level"
                    },
                    "properties": [
                      {
                        "id": "displayName",
                        "value": "Level"
                      },
                      {
                        "id": "custom.width",
                        "value": 64
                      },
                      {
                        "id": "custom.cellOptions",
                        "value": {
                          "type": "color-text"
                        }
                      },
                      {
                        "id": "mappings",
                        "value": [
                          {
                            "type": "value",
                            "options": {
                              "10": {
                                "text": "trace",
                                "color": "text",
                                "index": 0
                              },
                              "20": {
                                "text": "debug",
                                "color": "text",
                                "index": 1
                              },
                              "30": {
                                "text": "info",
                                "color": "text",
                                "index": 2
                              },
                              "40": {
                                "text": "warn",
                                "color": "orange",
                                "index": 3
                              },
                              "50": {
                                "text": "error",
                                "color": "red",
                                "index": 4
                              },
                              "60": {
                                "text": "fatal",
                                "color": "dark-red",
                                "index": 5
                              }
                            }
                          }
                        ]
                      }
                    ]
                  },
                  {
                    "matcher": {
                      "id": "byName",
                      "options": "source"
                    },
                    "properties": [
                      {
                        "id": "displayName",
                        "value": "Source"
                      },
                      {
                        "id": "custom.width",
                        "value": 230
                      }
                    ]
                  },
                  {
                    "matcher": {
                      "id": "byName",
                      "options": "operation"
                    },
                    "properties": [
                      {
                        "id": "displayName",
                        "value": "Operation"
                      },
                      {
                        "id": "custom.width",
                        "value": 170
                      }
                    ]
                  },
                  {
                    "matcher": {
                      "id": "byName",
                      "options": "message"
                    },
                    "properties": [
                      {
                        "id": "displayName",
                        "value": "Message"
                      },
                      {
                        "id": "custom.minWidth",
                        "value": 280
                      }
                    ]
                  },
                  {
                    "matcher": {
                      "id": "byName",
                      "options": "method"
                    },
                    "properties": [
                      {
                        "id": "displayName",
                        "value": "Method"
                      },
                      {
                        "id": "custom.width",
                        "value": 70
                      }
                    ]
                  },
                  {
                    "matcher": {
                      "id": "byName",
                      "options": "url"
                    },
                    "properties": [
                      {
                        "id": "displayName",
                        "value": "URL"
                      },
                      {
                        "id": "custom.width",
                        "value": 240
                      }
                    ]
                  },
                  {
                    "matcher": {
                      "id": "byName",
                      "options": "request"
                    },
                    "properties": [
                      {
                        "id": "displayName",
                        "value": "Request"
                      },
                      {
                        "id": "custom.width",
                        "value": 110
                      },
                      {
                        "id": "links",
                        "value": [
                          {
                            "title": "Every line of this request",
                            "url": "${backend_request_logs_url}",
                            "targetBlank": true
                          }
                        ]
                      }
                    ]
                  },
                  {
                    "matcher": {
                      "id": "byName",
                      "options": "code"
                    },
                    "properties": [
                      {
                        "id": "displayName",
                        "value": "Code"
                      },
                      {
                        "id": "custom.width",
                        "value": 150
                      }
                    ]
                  },
                  {
                    "matcher": {
                      "id": "byName",
                      "options": "task"
                    },
                    "properties": [
                      {
                        "id": "displayName",
                        "value": "Task"
                      },
                      {
                        "id": "custom.width",
                        "value": 130
                      }
                    ]
                  }
                ]
              },
              "targets": [
                {
                  "datasource": {
                    "type": "cloudwatch",
                    "uid": "${logs_datasource_uid}"
                  },
                  "expression": "fields @timestamp, level, context as source, operation, coalesce(msg, @message) as message, req.method as method, req.url as url, req.id as request, errorCode as code, replace(hostname, \".${aws_region}.compute.internal\", \"\") as task\n| filter @message not like /HealthController/\n| sort @timestamp desc\n| limit 500",
                  "id": "",
                  "logGroups": [
                    {
                      "accountId": "${account_id}",
                      "arn": "arn:aws:logs:${aws_region}:${account_id}:log-group:${ecs_log_group_name}:*",
                      "name": "${ecs_log_group_name}"
                    }
                  ],
                  "queryMode": "Logs",
                  "refId": "A",
                  "region": "${aws_region}",
                  "statsGroups": []
                }
              ],
              "transformations": [
                {
                  "id": "organize",
                  "options": {
                    "indexByName": {
                      "@timestamp": 0,
                      "Time": 0,
                      "level": 1,
                      "source": 2,
                      "operation": 3,
                      "message": 4,
                      "method": 5,
                      "url": 6,
                      "request": 7,
                      "code": 8,
                      "task": 9
                    }
                  }
                }
              ],
              "title": "Backend logs",
              "type": "table"
            }
          ],
          "gridPos": {
            "h": 1,
            "w": 24,
            "x": 0,
            "y": 0
          }
        }
      ]
    }
  ]
}
