{
  "kind": "InsightVizNode",
  "source": {
    "dateRange": {
      "date_from": "-30d",
      "explicitDate": false
    },
    "filterTestAccounts": false,
    "interval": "week",
    "kind": "LifecycleQuery",
    "lifecycleFilter": {
      "showLegend": false
    },
    "properties": [],
    "series": [
      {
        "event": "$pageview",
        "kind": "EventsNode",
        "name": "$pageview"
      }
    ]
  }
}
