#!/bin/bash
# Writes each user's password hash from the user's Secrets Manager secret, which `pnpm secrets:set`
# fills, so no password passes through OpenTofu. Its unit runs before ClickHouse starts. After a
# password changes, run this script itself, not its unit: restarting the unit restarts ClickHouse,
# while ClickHouse rereads the file on its own.
set -euo pipefail

hash_of() {
  aws secretsmanager get-secret-value --region "${region}" --secret-id "$1" \
    --query SecretString --output text |
    python3 -c 'import hashlib, json, sys; print(hashlib.sha256(json.load(sys.stdin)["password"].encode()).hexdigest())'
}

file=$(mktemp)
trap 'rm -f "$file"' EXIT
{
  echo "<clickhouse><users>"
%{ for user in users ~}
  echo "<${user.name}><password_sha256_hex>$(hash_of "${user.secret_name}")</password_sha256_hex></${user.name}>"
%{ endfor ~}
  echo "</users></clickhouse>"
} >"$file"
install -m 0640 -o root -g clickhouse "$file" /etc/clickhouse-server/users.d/openjii-passwords.xml
