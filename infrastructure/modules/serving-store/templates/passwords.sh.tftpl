#!/bin/bash
# Writes each user's password hash from the user's Secrets Manager secret, which `pnpm secrets:set`
# fills, so no password passes through OpenTofu. ClickHouse runs it before every start, and
# `secrets:set` runs it through SSM with --check after a change, which ClickHouse rereads on its own.
# The file is replaced only once every hash has come through. When a read fails, a run before a
# start keeps the last good file, so ClickHouse starts without waiting for Secrets Manager; with no
# good file, as on a new instance, it fails the start and ClickHouse's restart reads again. A run with
# --check fails instead, so a rotation never reports a password the store does not hold.
set -euo pipefail

check=0
if [[ $# -gt 0 && $1 == --check ]]; then
  check=1
fi
target=/etc/clickhouse-server/users.d/openjii-passwords.xml

# One run at a time, so a run that read an older secret cannot install over a newer one.
exec 9>/run/openjii-clickhouse-passwords.lock
flock 9

# A password must be printable ASCII without spaces, the rule `secrets:set` applies before it writes
# anything: `$(…)` would drop trailing line breaks and the login check's header would refuse other
# whitespace, so the store would hold a different password from its consumers. A missing, empty or
# other password prints nothing, which the caller refuses.
password_of() {
  aws secretsmanager get-secret-value --region "${region}" --secret-id "$1" \
    --query SecretString --output text |
    python3 -c '
import json, sys
p = json.load(sys.stdin).get("password")
plain = isinstance(p, str) and len(p) > 0 and all("!" <= c <= "~" for c in p)
sys.stdout.write(p if plain else "")'
}

# The password goes in on stdin, never as an argument, so no process listing shows it.
sha256_of() {
  printf %s "$1" | python3 -c 'import hashlib, sys; print(hashlib.sha256(sys.stdin.buffer.read()).hexdigest())'
}

# A file ClickHouse can parse, holding a hash for every user. A cut-off file would stop it starting.
last_good() {
  [[ -s $target ]] || return 1
  python3 -c 'import sys, xml.etree.ElementTree as tree; tree.parse(sys.argv[1])' "$target" 2>/dev/null || return 1
%{ for user in users ~}
  grep -Eq '<${user.name}><password_sha256_hex>[0-9a-f]{64}</password_sha256_hex>' "$target" || return 1
%{ endfor ~}
}

fail() {
  echo "$1" >&2
  if [[ $check == 0 ]] && last_good; then
    echo "Keeping the last good passwords file" >&2
    exit 0
  fi
  exit 1
}

# ClickHouse rereads users.d a moment after the file changes, so a login is retried until a deadline
# 30 seconds out. Each try is cut off after 5 seconds, so a server that takes the connection and
# never answers cannot hold the lock.
accepts() {
  local deadline=$((SECONDS + 30))
  while ((SECONDS < deadline)); do
    if printf 'X-ClickHouse-User: %s\nX-ClickHouse-Key: %s\n' "$1" "$2" |
      curl -sf -o /dev/null --connect-timeout 2 --max-time 5 -H @- \
        "http://127.0.0.1:${http_port}/?query=SELECT%201"; then
      return 0
    fi
    sleep 1
  done
  return 1
}

names=()
passwords=()

# Beside users.d, not in it, so ClickHouse never reads it half written, and on the same file system,
# so the move replaces the file in one step.
file=$(mktemp /etc/clickhouse-server/.openjii-passwords.XXXXXX)
trap 'rm -f "$file"' EXIT
echo "<clickhouse><users>" >"$file"
%{ for user in users ~}
if ! password=$(password_of "${user.secret_name}"); then
  fail "Could not read ${user.secret_name}"
fi
if [[ -z $password ]]; then
  fail "No usable password for ${user.name} in ${user.secret_name}: missing, empty, or not printable ASCII without spaces"
fi
digest=$(sha256_of "$password")
names+=("${user.name}")
passwords+=("$password")
echo "<${user.name}><password_sha256_hex>$digest</password_sha256_hex></${user.name}>" >>"$file"
%{ endfor ~}
echo "</users></clickhouse>" >>"$file"
chown root:clickhouse "$file"
chmod 0640 "$file"
mv -f "$file" "$target"

# Before a start ClickHouse is not up yet, so only a run against the running server checks the logins.
if [[ $check == 1 ]]; then
  for i in "$${!names[@]}"; do
    if ! accepts "$${names[i]}" "$${passwords[i]}"; then
      echo "The store does not accept $${names[i]}'s password; is clickhouse-server running?" >&2
      exit 1
    fi
  done
  echo "The store accepts every user's password."
fi
