<clickhouse>
    <!-- Every user shares this profile, so a key such as "Plot no." stays one key, never a path into
         a nested object. Its stored path is escaped, so a reader names the subcolumn the same way,
         as uploaded_data.`Plot no%2E`. -->
    <profiles>
        <default>
            <json_type_escape_dots_in_keys>1</json_type_escape_dots_in_keys>
        </default>
    </profiles>
    <users>
        <default remove="remove"/>
%{ for user in users ~}
        <${user.name}>
            <password_sha256_hex>${user.password_sha256}</password_sha256_hex>
            <networks><ip>::/0</ip></networks>
            <profile>default</profile>
            <quota>default</quota>
%{ if length(user.grants) == 0 ~}
            <access_management>1</access_management>
%{ else ~}
            <grants>
%{ for grant in user.grants ~}
                <query>${grant}</query>
%{ endfor ~}
            </grants>
%{ endif ~}
        </${user.name}>
%{ endfor ~}
    </users>
</clickhouse>
