#!/bin/bash
# Each store table's feed, once a minute: rows it took in the last minute and, over the last five,
# rows it refused and the p95 from gold's commit to the store's insert. Refused rows are counted
# over five minutes so that a run that fails or comes late cannot leave them unreported. A table
# nothing reached reports zero rows. The backend's reads and the platform metrics' views follow.
set -euo pipefail

query="
  SELECT 'measurements', countIf(inserted_at > now64(6) - INTERVAL 1 MINUTE),
    quantile(0.95)(dateDiff('millisecond', _commit_timestamp, inserted_at)) / 1000,
    (SELECT count() FROM store.feed_rejects
      WHERE source_table = 'measurements' AND rejected_at > now64(6) - INTERVAL 5 MINUTE)
  FROM store.measurements WHERE inserted_at > now64(6) - INTERVAL 5 MINUTE
  UNION ALL
  SELECT 'macro_results', countIf(inserted_at > now64(6) - INTERVAL 1 MINUTE),
    quantile(0.95)(dateDiff('millisecond', _commit_timestamp, inserted_at)) / 1000,
    (SELECT count() FROM store.feed_rejects
      WHERE source_table = 'macro_results' AND rejected_at > now64(6) - INTERVAL 5 MINUTE)
  FROM store.macro_results WHERE inserted_at > now64(6) - INTERVAL 5 MINUTE
  UNION ALL
  SELECT 'uploads', countIf(inserted_at > now64(6) - INTERVAL 1 MINUTE),
    quantile(0.95)(dateDiff('millisecond', _commit_timestamp, inserted_at)) / 1000,
    (SELECT count() FROM store.feed_rejects
      WHERE source_table = 'uploads' AND rejected_at > now64(6) - INTERVAL 5 MINUTE)
  FROM store.uploads WHERE inserted_at > now64(6) - INTERVAL 5 MINUTE
"

# Read first, so a store that does not answer fails the run instead of sending no metrics.
rows=$(clickhouse-client --user openjii_monitor --format TSV --query "$query")

# A deploy starts this timer before the migration that creates store.metadata_rows, so the sheets'
# rows are read on their own, and until the table exists only their metrics go unsent.
if sheet_rows=$(clickhouse-client --user openjii_monitor --format TSV --query "
  SELECT 'metadata_rows', countIf(inserted_at > now64(6) - INTERVAL 1 MINUTE),
    quantile(0.95)(dateDiff('millisecond', _commit_timestamp, inserted_at)) / 1000,
    (SELECT count() FROM store.feed_rejects
      WHERE source_table = 'metadata_rows' AND rejected_at > now64(6) - INTERVAL 5 MINUTE)
  FROM store.metadata_rows WHERE inserted_at > now64(6) - INTERVAL 5 MINUTE
"); then
  rows+=$'\n'"$sheet_rows"
else
  echo "metadata_rows metrics not sent: store.metadata_rows did not answer" >&2
fi

metrics=""
while IFS=$'\t' read -r table inserted p95 rejected; do
  dimensions="[{\"Name\":\"Environment\",\"Value\":\"${environment}\"},{\"Name\":\"Table\",\"Value\":\"$table\"}]"
  metrics+="{\"MetricName\":\"FeedInsertedRows\",\"Dimensions\":$dimensions,\"Value\":$inserted,\"Unit\":\"Count\"},"
  metrics+="{\"MetricName\":\"FeedRejectedRows\",\"Dimensions\":$dimensions,\"Value\":$rejected,\"Unit\":\"Count\"},"
  if [ "$p95" != "nan" ]; then
    metrics+="{\"MetricName\":\"FeedDeliveryP95Seconds\",\"Dimensions\":$dimensions,\"Value\":$p95,\"Unit\":\"Seconds\"},"
  fi
done <<<"$rows"

# The backend's reads, from the query log: how many ended, and how many failed, in a minute, and the
# p95 of their durations over five, with a failed read taken as the 30 s a read may last, so failing
# reads raise it. The windows end ten seconds back, past the log's 7.5 s flush, so each run counts a
# read once. Without reads there is no p95. A query log the timer cannot read costs these metrics
# alone, never the feed's above.
if read_stats=$(clickhouse-client --user openjii_monitor --format TSV --query "
  SELECT countIf(event_time > now() - INTERVAL 70 SECOND),
    countIf(event_time > now() - INTERVAL 70 SECOND AND type != 'QueryFinish'),
    quantile(0.95)(if(type = 'QueryFinish', query_duration_ms, 30000)) / 1000
  FROM system.query_log
  WHERE user = 'openjii_reader' AND type != 'QueryStart'
    AND event_time > now() - INTERVAL 310 SECOND AND event_time <= now() - INTERVAL 10 SECOND
"); then
  IFS=$'\t' read -r reads failed p95 <<<"$read_stats"
  dimensions="[{\"Name\":\"Environment\",\"Value\":\"${environment}\"}]"
  metrics+="{\"MetricName\":\"StoreReads\",\"Dimensions\":$dimensions,\"Value\":$reads,\"Unit\":\"Count\"},"
  metrics+="{\"MetricName\":\"StoreReadFailures\",\"Dimensions\":$dimensions,\"Value\":$failed,\"Unit\":\"Count\"},"
  if [ "$p95" != "nan" ]; then
    metrics+="{\"MetricName\":\"StoreReadP95Seconds\",\"Dimensions\":$dimensions,\"Value\":$p95,\"Unit\":\"Seconds\"},"
  fi
else
  echo "Read metrics not sent: the query log did not answer" >&2
fi

# The platform metrics' views, once the migration ledger holds 0010, which makes them: minutes since
# the stalest one last refreshed, counted from the server's start for one that has not since, and how
# many are missing, failed their last refresh, or have none since the start and are not about to. A
# failed view keeps its last figures and holds back every view after it. A ledger the timer cannot
# read counts as holding 0010, and refresh state it cannot read counts every view as failing, so the
# alert sees the gap rather than silence.
refresh_query="
  WITH [${join(", ", formatlist("'%s'", metrics_views))}] AS expected
  SELECT max(intDiv(dateDiff('second', ifNull(last_success_time, now() - uptime()), now()), 60)),
    length(expected) - count() + countIf(exception != ''
      OR (last_success_time IS NULL AND status NOT IN ('Running', 'WaitingForDependencies')))
  FROM system.view_refreshes
  WHERE database = 'store' AND has(expected, view)
"
views_made=$(clickhouse-client --user openjii_monitor --format TSV \
  --query "SELECT count() FROM store._migrations WHERE version = 10" || echo 1)
if [ "$views_made" != "0" ]; then
  dimensions="[{\"Name\":\"Environment\",\"Value\":\"${environment}\"}]"
  if refresh_stats=$(clickhouse-client --user openjii_monitor --format TSV --query "$refresh_query"); then
    IFS=$'\t' read -r age failing <<<"$refresh_stats"
    metrics+="{\"MetricName\":\"MetricsRefreshAgeMinutes\",\"Dimensions\":$dimensions,\"Value\":$age,\"Unit\":\"None\"},"
  else
    echo "Refresh age not sent: the view refreshes did not answer, so every view counts as failing" >&2
    failing=${length(metrics_views)}
  fi
  metrics+="{\"MetricName\":\"MetricsRefreshFailures\",\"Dimensions\":$dimensions,\"Value\":$failing,\"Unit\":\"Count\"},"
fi

aws cloudwatch put-metric-data --region "${region}" --namespace "${namespace}" --metric-data "[$${metrics%,}]"
