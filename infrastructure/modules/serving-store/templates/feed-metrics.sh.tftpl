#!/bin/bash
# Each store table's feed, once a minute: rows it took in the last minute and, over the last five,
# rows it refused and the p95 from gold's commit to the store's insert. Refused rows are counted
# over five minutes so that a run that fails or comes late cannot leave them unreported. A table
# nothing reached reports zero rows. The backend's reads follow.
set -euo pipefail

query="
  SELECT 'measurements', countIf(inserted_at > now64(6) - INTERVAL 1 MINUTE),
    quantile(0.95)(dateDiff('millisecond', _commit_timestamp, inserted_at)) / 1000,
    (SELECT count() FROM store.feed_rejects
      WHERE source_table = 'measurements' AND rejected_at > now64(6) - INTERVAL 5 MINUTE)
  FROM store.measurements WHERE inserted_at > now64(6) - INTERVAL 5 MINUTE
  UNION ALL
  SELECT 'macro_results', countIf(inserted_at > now64(6) - INTERVAL 1 MINUTE),
    quantile(0.95)(dateDiff('millisecond', _commit_timestamp, inserted_at)) / 1000,
    (SELECT count() FROM store.feed_rejects
      WHERE source_table = 'macro_results' AND rejected_at > now64(6) - INTERVAL 5 MINUTE)
  FROM store.macro_results WHERE inserted_at > now64(6) - INTERVAL 5 MINUTE
  UNION ALL
  SELECT 'uploads', countIf(inserted_at > now64(6) - INTERVAL 1 MINUTE),
    quantile(0.95)(dateDiff('millisecond', _commit_timestamp, inserted_at)) / 1000,
    (SELECT count() FROM store.feed_rejects
      WHERE source_table = 'uploads' AND rejected_at > now64(6) - INTERVAL 5 MINUTE)
  FROM store.uploads WHERE inserted_at > now64(6) - INTERVAL 5 MINUTE
"

# Read first, so a store that does not answer fails the run instead of sending no metrics.
rows=$(clickhouse-client --user openjii_monitor --format TSV --query "$query")

metrics=""
while IFS=$'\t' read -r table inserted p95 rejected; do
  dimensions="[{\"Name\":\"Environment\",\"Value\":\"${environment}\"},{\"Name\":\"Table\",\"Value\":\"$table\"}]"
  metrics+="{\"MetricName\":\"FeedInsertedRows\",\"Dimensions\":$dimensions,\"Value\":$inserted,\"Unit\":\"Count\"},"
  metrics+="{\"MetricName\":\"FeedRejectedRows\",\"Dimensions\":$dimensions,\"Value\":$rejected,\"Unit\":\"Count\"},"
  if [ "$p95" != "nan" ]; then
    metrics+="{\"MetricName\":\"FeedDeliveryP95Seconds\",\"Dimensions\":$dimensions,\"Value\":$p95,\"Unit\":\"Seconds\"},"
  fi
done <<<"$rows"

# The backend's reads, from the query log: how many finished or failed in the last minute, and over
# the last five, how many failed and the p95 of those that finished. Without reads there is no p95.
# A query log the timer cannot read costs these metrics alone, never the feed's above.
if read_stats=$(clickhouse-client --user openjii_monitor --format TSV --query "
  SELECT countIf(event_time > now() - INTERVAL 1 MINUTE), countIf(type != 'QueryFinish'),
    quantileIf(0.95)(query_duration_ms, type = 'QueryFinish') / 1000
  FROM system.query_log
  WHERE user = 'openjii_reader' AND type != 'QueryStart' AND event_time > now() - INTERVAL 5 MINUTE
"); then
  IFS=$'\t' read -r reads failed p95 <<<"$read_stats"
  dimensions="[{\"Name\":\"Environment\",\"Value\":\"${environment}\"}]"
  metrics+="{\"MetricName\":\"StoreReads\",\"Dimensions\":$dimensions,\"Value\":$reads,\"Unit\":\"Count\"},"
  metrics+="{\"MetricName\":\"StoreReadFailures\",\"Dimensions\":$dimensions,\"Value\":$failed,\"Unit\":\"Count\"},"
  if [ "$p95" != "nan" ]; then
    metrics+="{\"MetricName\":\"StoreReadP95Seconds\",\"Dimensions\":$dimensions,\"Value\":$p95,\"Unit\":\"Seconds\"},"
  fi
else
  echo "Read metrics not sent: the query log did not answer" >&2
fi

aws cloudwatch put-metric-data --region "${region}" --namespace "${namespace}" --metric-data "[$${metrics%,}]"
