{
  "name": "@repo/cms",
  "version": "1.0.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./lib/__generated/sdk": {
      "types": "./dist/lib/__generated/sdk.d.ts",
      "default": "./dist/lib/__generated/sdk.js"
    },
    "./alert": {
      "types": "./dist/features/alert/severity.d.ts",
      "default": "./dist/features/alert/severity.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    }
  },
  "scripts": {
    "build": "tsc --build --verbose",
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "dev": "tsc --watch",
    "format": "prettier --check . --ignore-path ../../.gitignore",
    "lint": "eslint",
    "check-types": "tsc --noEmit",
    "codegen": "graphql-codegen -r dotenv/config --config src/codegen.ts",
    "codegen:watch": "graphql-codegen --watch -r dotenv/config --config src/codegen.ts"
  },
  "dependencies": {
    "graphql-request": "^7.4.0",
    "graphql-tag": "^2.12.6"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "^6.2.1",
    "@graphql-codegen/introspection": "^5.0.1",
    "@graphql-codegen/typescript": "^5.0.9",
    "@graphql-codegen/typescript-graphql-request": "^7.0.0",
    "@graphql-codegen/typescript-operations": "^5.0.9",
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "typescript": "catalog:"
  }
}
