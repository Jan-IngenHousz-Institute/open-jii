{
  "name": "@repo/auth",
  "version": "0.0.1",
  "exports": {
    "./server": {
      "types": "./src/server.ts",
      "default": "./dist/server.js"
    },
    "./access": {
      "types": "./src/access.ts",
      "default": "./dist/access.js"
    },
    "./passkey": {
      "types": "./src/passkey.ts",
      "default": "./dist/passkey.js"
    },
    "./organization": {
      "types": "./src/organization/plugin.ts",
      "default": "./dist/organization/plugin.js"
    },
    "./client": {
      "types": "./src/clients/client.web.ts",
      "default": "./dist/clients/client.web.js"
    },
    "./client.native": {
      "types": "./src/clients/client.native.ts",
      "default": "./dist/clients/client.native.js"
    },
    "./types": {
      "types": "./src/types.ts",
      "default": "./dist/types.js"
    },
    "./oauth-redirect": {
      "types": "./src/clients/oauth-redirect.ts",
      "default": "./dist/clients/oauth-redirect.js"
    },
    "./oidc-client-manifest": {
      "types": "./src/oidc/provisioning/manifest.ts",
      "default": "./dist/oidc/provisioning/manifest.js"
    },
    "./oidc-client-reconcile": {
      "types": "./src/oidc/provisioning/reconcile.ts",
      "default": "./dist/oidc/provisioning/reconcile.js"
    }
  },
  "private": true,
  "scripts": {
    "build": "tsc --build --verbose",
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "dev": "tsc --watch",
    "format": "prettier --check . --ignore-path ../../.gitignore",
    "lint": "eslint",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "check-types": "tsc --noEmit",
    "oauth:register": "node --env-file=../../apps/backend/.env dist/scripts/register-oauth-client.js"
  },
  "dependencies": {
    "@aws-sdk/client-secrets-manager": "catalog:aws-sdk",
    "@aws-sdk/client-sts": "catalog:aws-sdk",
    "@better-auth/api-key": "1.6.23",
    "@better-auth/expo": "1.6.23",
    "@better-auth/oauth-provider": "1.6.23",
    "@better-auth/passkey": "1.6.23",
    "@repo/database": "workspace:*",
    "@repo/transactional": "workspace:*",
    "@simplewebauthn/browser": "13.3.0",
    "better-auth": "1.6.23",
    "nodemailer": "catalog:"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@repo/vitest-config": "workspace:*",
    "@types/express": "^5.0.6",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:testing",
    "eslint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:testing"
  }
}
