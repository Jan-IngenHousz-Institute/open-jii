{
  "name": "openjii_reader",
  "views": [
    "experiment_measurements",
    "experiment_macro_results",
    "experiment_uploads",
    "experiment_contributor_ids",
    "experiment_client_ids",
    "experiment_payload_schemas",
    "experiment_metadata_rows",
    "experiment_metadata_sheets",
    "device_measurements",
    "device_experiment_ids",
    "device_newest_measurements",
    "device_lifecycle_events",
    "device_last_activity",
    "device_events_reloaded",
    "metrics_platform_totals",
    "metrics_daily_activity",
    "metrics_client_totals",
    "metrics_hourly_activity",
    "metrics_activity_windows",
    "metrics_daily_activity_by_experiment",
    "metrics_daily_activity_by_resource",
    "metrics_experiment_contributors_window",
    "metrics_experiment_devices_window",
    "metrics_pool_facts",
    "metrics_parameter_stats"
  ],
  "tables": ["measurements", "macro_results", "uploads"],
  "rowFilter": "experiment_id = getSetting('SQL_experiment')",
  "settings": [
    "json_type_escape_dots_in_keys = 1",
    "input_format_try_infer_dates = 0",
    "input_format_try_infer_datetimes = 0",
    "max_memory_usage = 4294967296 CONST",
    "max_execution_time = 30 CONST",
    "max_memory_usage_for_user = 6442450944 CONST",
    "timeout_overflow_mode CONST",
    "apply_deleted_mask CONST",
    "workload CONST"
  ]
}
