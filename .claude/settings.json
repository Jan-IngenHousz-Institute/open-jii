{
  "permissions": {
    "ask": [
      "Bash(pnpm status:incident publish:*)",
      "Bash(pnpm cms:models apply:*)",
      "Bash(pnpm --filter @repo/devkit status:incident publish:*)",
      "Bash(pnpm --filter @repo/devkit cms:models apply:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/protect-main.sh"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/docs-reminder.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/docs-reminder.sh"
          }
        ]
      }
    ]
  }
}
