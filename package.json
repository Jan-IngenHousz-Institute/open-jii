{
  "name": "open-jii",
  "private": true,
  "scripts": {
    "analyst:prod-window": "pnpm --filter @repo/devkit analyst:prod-window --",
    "build": "turbo build --concurrency 20",
    "build:affected": "turbo build --affected",
    "build:apps": "turbo build --filter=./apps/*",
    "build:packages": "turbo build --filter=./packages/*",
    "check:affected": "turbo ls --affected",
    "clean": "git clean -xdf node_modules .turbo",
    "clean:workspaces": "turbo run clean && pnpm run clean",
    "db:generate": "turbo --filter @repo/database db:generate",
    "db:migrate": "turbo db:migrate",
    "db:setup": "turbo db:setup",
    "db:studio": "turbo --filter @repo/database db:studio",
    "dev": "turbo dev --concurrency 20",
    "dev:fb": "turbo run dev --filter=backend --filter=web",
    "e2e": "pnpm --filter @repo/e2e e2e",
    "format": "prettier --write \"**/*.{ts,tsx,js,md,mdx,css,yaml,yml,json}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,md,mdx,css,yaml,yml,json}\"",
    "linear:apply": "pnpm --filter @repo/devkit linear:apply --",
    "linear:auth": "pnpm --filter @repo/devkit linear:auth --",
    "linear:check": "pnpm --filter @repo/devkit linear:check --",
    "linear:create": "pnpm --filter @repo/devkit linear:create --",
    "linear:document": "pnpm --filter @repo/devkit linear:document --",
    "linear:query": "pnpm --filter @repo/devkit linear:query --",
    "linear:taxonomy": "pnpm --filter @repo/devkit linear:taxonomy --",
    "linear:upload": "pnpm --filter @repo/devkit linear:upload --",
    "linear:view": "pnpm --filter @repo/devkit linear:view --",
    "lint": "turbo run lint --concurrency 20 --continue -- --no-cache",
    "lint:fix": "turbo run lint --continue -- --fix --no-cache",
    "lint:ws": "pnpm dlx sherif@latest",
    "local:login": "pnpm --filter @repo/devkit login --",
    "roles:check": "pnpm --filter @repo/devkit roles:check",
    "roles:generate": "pnpm --filter @repo/devkit roles:generate",
    "test": "turbo test --concurrency 20",
    "test:coverage": "turbo run test:coverage",
    "test:projects": "vitest run",
    "test:projects:watch": "vitest --watch",
    "test:watch": "turbo test --watch",
    "tf": "pnpm run tf:dev",
    "tf:dev": "cd infrastructure/env/dev && tofu init && tofu plan && tofu apply",
    "tf:fmt": "cd infrastructure && tofu fmt --recursive",
    "typecheck": "turbo run typecheck",
    "ui-add": "turbo run ui-add",
    "view-report": "turbo run view-report"
  },
  "devDependencies": {
    "@repo/vitest-config": "workspace:*",
    "@trivago/prettier-plugin-sort-imports": "^5.2.2",
    "prettier": "3.5.3",
    "prettier-plugin-tailwindcss": "0.6.12",
    "turbo": "^2.10.5",
    "typescript": "catalog:",
    "vite": "^7.3.5",
    "vitest": "catalog:testing"
  },
  "packageManager": "pnpm@11.15.0+sha512.266f8957a30d2be6e9468e5e66bcdedd35a794175f71b067ba8504d686cce1d0c0f429b33c323c3c569ad4891e667574a49ff71d1b89a22cc66f13c65818c578",
  "engines": {
    "node": ">=24"
  }
}
