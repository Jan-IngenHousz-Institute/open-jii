{
  "name": "open-jii",
  "private": true,
  "scripts": {
    "build": "turbo build --concurrency 20",
    "build:apps": "turbo build --filter=./apps/*",
    "build:packages": "turbo build --filter=./packages/*",
    "build:affected": "turbo build --affected",
    "clean": "git clean -xdf node_modules .turbo",
    "clean:workspaces": "turbo run clean && pnpm run clean",
    "dev": "turbo dev --concurrency 20",
    "check:affected": "turbo ls --affected",
    "format": "prettier --write \"**/*.{ts,tsx,js,md,mdx,css,yaml,yml,json}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,md,mdx,css,yaml,yml,json}\"",
    "lint": "turbo run lint --concurrency 20 --continue -- --no-cache",
    "lint:fix": "turbo run lint --continue -- --fix --no-cache",
    "lint:ws": "pnpm dlx sherif@latest",
    "test": "turbo test --concurrency 20",
    "test:watch": "turbo test --watch",
    "test:coverage": "turbo run test:coverage",
    "test:projects": "vitest run",
    "test:projects:watch": "vitest --watch",
    "e2e": "pnpm --filter @repo/e2e e2e",
    "view-report": "turbo run view-report",
    "tf": "pnpm run tf:dev",
    "tf:fmt": "cd infrastructure && tofu fmt --recursive",
    "tf:dev": "test \"$(tofu version | head -n 1)\" = \"OpenTofu v$(cat .opentofu-version)\" || { echo \"Use OpenTofu $(cat .opentofu-version), the version in .opentofu-version\" >&2; exit 1; }; cd infrastructure/env/dev && tofu init && tofu plan",
    "db:migrate": "turbo db:migrate",
    "db:generate": "turbo --filter @repo/database db:generate",
    "db:studio": "turbo --filter @repo/database db:studio",
    "db:setup": "turbo db:setup",
    "typecheck": "turbo run check-types",
    "ui-add": "turbo run ui-add",
    "dev:fb": "turbo run dev --filter=backend --filter=web",
    "local:login": "pnpm --filter @repo/devkit run login --",
    "linear:apply": "pnpm --filter @repo/devkit linear:apply --",
    "linear:auth": "pnpm --filter @repo/devkit linear:auth --",
    "linear:check": "pnpm --filter @repo/devkit linear:check --",
    "linear:create": "pnpm --filter @repo/devkit linear:create --",
    "linear:document": "pnpm --filter @repo/devkit linear:document --",
    "linear:milestones": "pnpm --filter @repo/devkit linear:milestones --",
    "linear:query": "pnpm --filter @repo/devkit linear:query --",
    "linear:resources": "pnpm --filter @repo/devkit linear:resources --",
    "linear:taxonomy": "pnpm --filter @repo/devkit linear:taxonomy --",
    "linear:upload": "pnpm --filter @repo/devkit linear:upload --",
    "linear:view": "pnpm --filter @repo/devkit linear:view --",
    "posthog:auth": "pnpm --filter @repo/devkit posthog:auth --",
    "posthog:issues": "pnpm --filter @repo/devkit posthog:issues --",
    "posthog:query": "pnpm --filter @repo/devkit posthog:query --",
    "grafana:auth": "pnpm --filter @repo/devkit grafana:auth --",
    "grafana:get": "pnpm --filter @repo/devkit grafana:get --",
    "ingest:replay": "pnpm --filter @repo/devkit ingest:replay --",
    "cms:models": "pnpm --filter @repo/devkit cms:models --",
    "round:read": "pnpm --filter @repo/devkit round:read --",
    "status:fixtures": "pnpm --filter @repo/devkit status:fixtures --",
    "status:incident": "pnpm --filter @repo/devkit status:incident --",
    "secrets:ses-smtp": "pnpm --filter @repo/devkit secrets:ses-smtp --",
    "secrets:set": "pnpm --filter @repo/devkit secrets:set --"
  },
  "devDependencies": {
    "@repo/vitest-config": "workspace:*",
    "@trivago/prettier-plugin-sort-imports": "^5.2.2",
    "@types/node": "catalog:",
    "prettier": "3.5.3",
    "prettier-plugin-tailwindcss": "0.6.12",
    "turbo": "2.11.13",
    "typescript": "catalog:",
    "vite": "^7.3.7",
    "vitest": "catalog:testing"
  },
  "packageManager": "pnpm@12.23.0+sha512.02da94ffaf133f46074322afe552f90d40b5f71ae259aefbccdacc5085b1d617e98d65e0131f5748b9b67445978ee5055d7d59a473f1eef0d504854fefcd5975",
  "engines": {
    "node": ">=26"
  }
}
