+      canLeave={caps.canLeave ?? false}
+      canManage={caps.canManage ?? true}
+    >
+      <p>tab body</p>
+    </DeviceGroupDetailTabs>,
+  );
+}
+
+describe("DeviceGroupDetailTabs", () => {
