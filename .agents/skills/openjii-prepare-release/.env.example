# Add only the selected integration's keys to tooling/devkit/.env, which is gitignored and
# owner-only. The devkit reads it in process; shell values override the file, which is how CI
# supplies them. GitHub discovery and branches use gh auth login.

# Required for live Contentful reads/writes. Explicit environment; no master fallback.
CONTENTFUL_SPACE_ID=
CONTENTFUL_SPACE_ENVIRONMENT=
CONTENTFUL_MANAGEMENT_TOKEN=
# Older files may use CMA instead of CONTENTFUL_MANAGEMENT_TOKEN.
# CMA=
# Delivery CONTENTFUL_ACCESS_TOKEN and PREVIEW tokens cannot write content.

# Written by `pbpaste | pnpm linear:auth`, which verifies the key before storing it. Set it by
# hand only if that command cannot run; never paste it onto a command line.
LINEAR_API_KEY=
# Resolve the project UUID and name before writing; this is not an issue ID.
LINEAR_PROJECT_ID=

# Optional mobile build evidence, and only on a machine that cuts releases. Build existence
# does not prove Play availability.
EXPO_TOKEN=

# Browser capture uses a dev session; never put OTPs or cookies in this example.
# Repo capture variables, only for the LOCAL seeded Playwright path:
# E2E_BASE_URL=http://localhost:3000
# OPENJII_CAPTURE_STAGING_DIR=/absolute/path/to/.release-prep/release-id/media
