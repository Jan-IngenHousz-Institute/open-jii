# Add only the selected integration's keys to the ignored root .env.
# The CMS helper parses dotenv as data. Shell values override the file.
# GitHub discovery/branches use gh auth login, or GH_TOKEN in the shell.

# Required for live Contentful reads/writes. Explicit environment; no master fallback.
CONTENTFUL_SPACE_ID=
CONTENTFUL_SPACE_ENVIRONMENT=
CONTENTFUL_MANAGEMENT_TOKEN=
# Existing root .env files may use CMA instead of CONTENTFUL_MANAGEMENT_TOKEN.
# CMA=
# Delivery CONTENTFUL_ACCESS_TOKEN and PREVIEW tokens cannot write content.

# Only needed when the selected Linear operation cannot use the connected MCP.
LINEAR_API_KEY=
# Resolve the project UUID and name before writing; this is not an issue ID.
LINEAR_PROJECT_ID=

# Optional mobile build evidence. Build existence does not prove Play availability.
EXPO_TOKEN=

# Browser capture uses a dev session; never put OTPs or cookies in this example.
# Repo capture variables, only for the LOCAL seeded Playwright path:
# E2E_BASE_URL=http://localhost:3000
# OPENJII_CAPTURE_STAGING_DIR=/absolute/path/to/.release-prep/release-id/media
